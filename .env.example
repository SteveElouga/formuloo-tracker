# Formuloo Tracker — variables d'environnement (EXEMPLE).
# Copier en .env (jamais committé — MEMORY.md S1/S2). Valeurs ci-dessous = placeholders non sensibles.
# FT-1 : socle minimal. FT-2 ajoute Postgres, Keycloak, RabbitMQ, Redis, MinIO, Traefik.

# ─── Projet / registre ───────────────────────────────────
COMPOSE_PROJECT_NAME=formuloo
GHCR_OWNER=steveelouga            # ghcr.io/<owner>/formuloo-tracker/<image>

# ─── Gateway GraphQL (dev/local) ─────────────────────────
GATEWAY_DEBUG=1
GATEWAY_SECRET_KEY=dev-insecure-change-me     # placeholder — remplacer en réel (jamais versionné)
GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Frontend ────────────────────────────────────────────
FRONTEND_API_MODE=live            # live | mock  (mock = MSW sans backend, FT-6b)

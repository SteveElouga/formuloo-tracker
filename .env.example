# GP-Formuloo — variables d'environnement (EXEMPLE).
# Copier en .env (jamais committé — MEMORY.md S1/S2). Valeurs = placeholders NON sensibles à remplacer.

# ─── Projet / registre ───────────────────────────────────
COMPOSE_PROJECT_NAME=gp-formuloo
GHCR_OWNER=steveelouga

# ─── Gateway GraphQL (FT-1) ──────────────────────────────
GATEWAY_DEBUG=1
GATEWAY_SECRET_KEY=dev-insecure-change-me
GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Frontend (FT-1) ─────────────────────────────────────
FRONTEND_API_MODE=live            # live | mock (MSW sans backend, FT-6b)

# ─── PostgreSQL (FT-2) ───────────────────────────────────
POSTGRES_USER=formuloo
POSTGRES_PASSWORD=dev-postgres-change-me
POSTGRES_DB=formuloo
# Bases créées en plus par init-databases.sh (DB-per-service, ADR-004) :
POSTGRES_EXTRA_DBS=keycloak,projects,issues,agile,notifications

# ─── Keycloak (FT-2) ─────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-change-me
KC_DB_URL_DATABASE=keycloak        # base Postgres dédiée à Keycloak
KEYCLOAK_HOSTNAME=keycloak.localhost   # routé par Traefik (edge)

# ─── RabbitMQ (FT-2) ─────────────────────────────────────
RABBITMQ_DEFAULT_USER=formuloo
RABBITMQ_DEFAULT_PASS=dev-rabbit-change-me

# ─── Redis (FT-2) ────────────────────────────────────────
REDIS_PASSWORD=dev-redis-change-me

# ─── MinIO (FT-2) ────────────────────────────────────────
MINIO_ROOT_USER=formuloo
MINIO_ROOT_PASSWORD=dev-minio-change-me    # ≥ 8 caractères exigé par MinIO

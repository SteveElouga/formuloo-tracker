#!/bin/sh
# GP-Formuloo — hook commit-msg : valide les Conventional Commits (ADR-019 ; MEMORY.md §5).
set -eu

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

# Laisser passer les commits techniques automatiques
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "✖ [commit-msg] Message non conforme aux Conventional Commits (MEMORY.md §5, ADR-019)."
  echo "  Format : <type>(portée optionnelle): description"
  echo "  Types  : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Exemple: feat(issues): FT-18 création de ticket"
  exit 1
fi
exit 0
